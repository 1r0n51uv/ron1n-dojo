# Segreti del gateway dei modelli. Copia in .env (permessi 600).

# Chiave di amministrazione di LiteLLM (inizia con sk-): crea le chiavi
# virtuali delle stanze. Genera con: echo "sk-$(openssl rand -hex 24)"
LITELLM_MASTER_KEY=
POSTGRES_PASSWORD=

# Provider. Basta quelli che usi: un provider vuoto viene saltato dai
# fallback.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
