# Segreti del gateway dei modelli. Copia in .env (permessi 600).

# Chiave di amministrazione di LiteLLM (inizia con sk-): crea le chiavi
# virtuali delle rooms. Genera con: echo "sk-$(openssl rand -hex 24)"
LITELLM_MASTER_KEY=
POSTGRES_PASSWORD=

# Provider. Basta quelli che usi: un provider vuoto viene saltato dai
# fallback.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# Abbonamento ChatGPT (Plus o Pro) davanti a strong e fast: lo imposta
# `scripts/dojo.sh chatgpt` dopo il login, e `dojo.sh chatgpt off` lo toglie.
# LITELLM_CONFIG=config.chatgpt.yaml
