# Valori comuni a tutti i profili della stanza kajiba. Copia in .env
# (permessi 600): `scripts/dojo.sh sync kajiba` li copia nel .env di ogni
# profilo. Non entrano nell'ambiente del container.
# Token e bot dei singoli agenti stanno in profili/<agente>/.env.

# Chiave virtuale della stanza sul gateway dei modelli, con il suo budget:
# `scripts/dojo.sh chiave kajiba`.
LITELLM_API_KEY=

# Utente Telegram autorizzato (il tuo user ID numerico, da @userinfobot).
TELEGRAM_ALLOWED_USERS=

# Porta della dashboard di Hermes su 127.0.0.1 (opzionale, default 9119). Le
# credenziali stanno in pannello.env, che `scripts/dojo.sh sync` crea da solo.
# DASHBOARD_PORT=9119
