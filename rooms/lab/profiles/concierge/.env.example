# Valori di questo agente. Copia in .env (permessi 600): `scripts/dojo.sh
# sync lab` lo unisce a ../../.env e lo copia nel profile.

# Bot Telegram dell'agente, da @BotFather. Un bot per agente: Hermes rifiuta
# lo stesso token su due profiles.
TELEGRAM_BOT_TOKEN=

# Token GitHub fine-grained dell'account degli agenti, limitato ai repo app.
# Permessi: docs/specs/rooms.md (ROOM-003).
GH_TOKEN=
