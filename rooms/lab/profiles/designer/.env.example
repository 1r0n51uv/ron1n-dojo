# Valori di questo agente. Copia in .env (permessi 600) o usa `scripts/dojo.sh
# secret`: `scripts/dojo.sh up` lo unisce a ../../.env e lo copia nel profile.

# Bot Telegram dell'agente, da @BotFather. Un bot per agente: Hermes rifiuta
# lo stesso token su due profiles.
TELEGRAM_BOT_TOKEN=

# Token GitHub fine-grained del tuo account, solo per questo agente e
# limitato ai repo dei progetti. Permessi: docs/specs/rooms.md (ROOM-003).
GH_TOKEN=
