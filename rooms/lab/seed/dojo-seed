#!/opt/hermes/.venv/bin/python
"""Porta config e SOUL dell'immagine nei profiles della room (ROOM-012).

Gira a ogni avvio del container hermes, come utente hermes, prima del
gateway (/etc/cont-init.d/016-dojo-seed). Per ogni profile in
/opt/dojo/profiles:

- se manca lo crea con `hermes profile create <nome> --no-skills`;
- scrive config.yaml e SOUL.md dell'immagine, ma dal secondo avvio tiene
  dal config.yaml che c'era le scelte fatte da Hermes: modello, provider,
  riserve e comandi approvati per sempre (CHIAVI_TENUTE); il file
  `.dojo-seed` nel profile segna il primo seed;
- copia `scripts/` del profile (script dei cron) in `scripts/` del suo home e,
  se c'è `cron.yaml`, crea o aggiorna per nome il job cron (ROOM-017);
- non tocca .env, memoria e sessioni.

Un errore su un profile non ferma gli altri né l'avvio della room.
"""

import io
import json
import shutil
import subprocess
import sys
from pathlib import Path

from ruamel.yaml import YAML

SORGENTE = Path("/opt/dojo/profiles")
HOME = Path("/opt/data")
CHIAVI_TENUTE = ("model", "providers", "fallback_providers", "custom_providers", "command_allowlist")

yaml = YAML()
yaml.preserve_quotes = True


def cartella(nome: str) -> Path:
    return HOME if nome == "default" else HOME / "profiles" / nome


def unisci(nuovo_testo: str, vecchio: Path) -> str:
    """Il config dell'immagine con le CHIAVI_TENUTE del config che c'era."""
    if not vecchio.is_file():
        return nuovo_testo
    prima = yaml.load(vecchio.read_text(encoding="utf-8")) or {}
    nuovo = yaml.load(nuovo_testo)
    for chiave in CHIAVI_TENUTE:
        if chiave in prima:
            nuovo[chiave] = prima[chiave]
    out = io.StringIO()
    yaml.dump(nuovo, out)
    return out.getvalue()


def scrivi(percorso: Path, testo: str) -> None:
    tmp = percorso.with_name(percorso.name + ".dojo-seed")
    tmp.write_text(testo, encoding="utf-8")
    tmp.replace(percorso)


def copia_scripts(nome: str, dest: Path) -> None:
    """Gli script dei cron di questo profile: `hermes cron` li cerca in <home>/scripts/."""
    src = SORGENTE / nome / "scripts"
    if not src.is_dir():
        return
    (dest / "scripts").mkdir(exist_ok=True)
    for f in src.iterdir():
        if f.is_file():
            shutil.copyfile(f, dest / "scripts" / f.name)
            (dest / "scripts" / f.name).chmod(0o755)


def trova_job(dest: Path, nome_job: str) -> str | None:
    """L'id del job cron con quel nome nel profile, se c'è."""
    store = dest / "cron" / "jobs.json"
    if not store.is_file():
        return None
    dati = json.loads(store.read_text(encoding="utf-8"))
    jobs = dati.get("jobs", []) if isinstance(dati, dict) else dati
    for j in jobs:
        if isinstance(j, dict) and j.get("name") == nome_job:
            return j.get("id")
    return None


def semina_cron(nome: str, dest: Path) -> None:
    """Crea o aggiorna il job di `cron.yaml`: a ogni avvio dell'immagine, per nome, così la sua
    definizione vive nel repo e non nello stato del volume."""
    f = SORGENTE / nome / "cron.yaml"
    if not f.is_file():
        return
    c = yaml.load(f.read_text(encoding="utf-8"))
    hermes = shutil.which("hermes") or "/opt/hermes/.venv/bin/hermes"
    job = trova_job(dest, c["name"])
    comune = ["--name", c["name"], "--deliver", c.get("deliver", "local")]
    for skill in c.get("skills", []):
        comune += ["--skill", skill]
    if c.get("monitor_script"):
        comune += ["--monitor-script", c["monitor_script"]]
    if c.get("workdir"):
        # Hermes rifiuta un workdir che non c'è ancora.
        Path(c["workdir"]).mkdir(parents=True, exist_ok=True)
        comune += ["--workdir", c["workdir"]]
    prompt = str(c["prompt"]).strip()
    if job:
        # `--skill` in `edit` sostituisce l'elenco: il file è la verità.
        cmd = [hermes, "-p", nome, "cron", "edit", job, "--schedule", c["schedule"], "--prompt", prompt, *comune]
    else:
        cmd = [hermes, "-p", nome, "cron", "create", *comune, c["schedule"], prompt]
    if nome == "default":
        cmd = [x for x in cmd if x not in ("-p", nome)]
    r = subprocess.run(cmd, capture_output=True, text=True)
    if r.returncode != 0:
        raise RuntimeError(f"hermes cron: {(r.stderr or r.stdout).strip()[-400:]}")
    print(f"[dojo-seed] cron {c['name']} {'aggiornato' if job else 'creato'} per {nome}")


def semina(nome: str) -> None:
    dest = cartella(nome)
    if nome != "default" and not (dest / "config.yaml").is_file():
        hermes = shutil.which("hermes") or "/opt/hermes/.venv/bin/hermes"
        subprocess.run([hermes, "profile", "create", nome, "--no-skills"], check=True)
    dest.mkdir(parents=True, exist_ok=True)
    testo = (SORGENTE / nome / "config.yaml").read_text(encoding="utf-8")
    # Prima del primo seed il config è quello di serie di Hermes (scritto da
    # `profile create` o dal primo avvio), non una scelta dell'utente: vince
    # quello dell'immagine. Dopo, le CHIAVI_TENUTE restano.
    segno = dest / ".dojo-seed"
    scrivi(dest / "config.yaml", unisci(testo, dest / "config.yaml") if segno.exists() else testo)
    segno.touch()
    shutil.copyfile(SORGENTE / nome / "SOUL.md", dest / "SOUL.md")
    copia_scripts(nome, dest)
    semina_cron(nome, dest)


def main() -> int:
    # Login della CLI di Claude (MODELS-006): solo l'utente hermes lo legge.
    (HOME / "claude").mkdir(mode=0o700, exist_ok=True)
    errori = 0
    # Prima il default: è la radice di HERMES_HOME, dove stanno gli altri.
    for p in sorted(SORGENTE.iterdir(), key=lambda p: p.name != "default"):
        if not p.is_dir():
            continue
        try:
            semina(p.name)
            print(f"[dojo-seed] ok {p.name}")
        except Exception as e:  # noqa: BLE001 - un profile rotto non ferma gli altri
            errori += 1
            print(f"[dojo-seed] ERRORE {p.name}: {e}", file=sys.stderr)
    return 0 if errori == 0 else 1


if __name__ == "__main__":
    # L'avvio della room va avanti comunque: gli errori restano nei log.
    main()
