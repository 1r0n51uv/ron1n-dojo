# Valori comuni a tutti i profiles della room lab. Copia in .env (permessi
# 600) o lascia fare a scripts/install.sh: `scripts/dojo.sh up` li copia nel
# .env di ogni profile. Token e bot dei singoli agenti stanno in
# profiles/<agente>/.env.

# Utente Telegram autorizzato (il tuo user ID numerico, da @userinfobot).
TELEGRAM_ALLOWED_USERS=

# Porta della dashboard di Hermes su 127.0.0.1 (opzionale, default 9119). Le
# credenziali stanno in dashboard.env, che `scripts/dojo.sh up` crea da solo.
# DASHBOARD_PORT=9119

# Porta della WebUI su 127.0.0.1 (opzionale, default 8787). Password in
# webui.env, che `scripts/dojo.sh up` crea da solo.
# WEBUI_PORT=8787
