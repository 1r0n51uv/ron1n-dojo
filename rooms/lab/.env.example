# Valori comuni a tutti i profiles della room lab. Copia in .env
# (permessi 600): `scripts/dojo.sh sync lab` li copia nel .env di ogni
# profile. Non entrano nell'ambiente del container.
# Token e bot dei singoli agenti stanno in profiles/<agente>/.env.

# Chiave virtuale della room sul gateway dei modelli, con il suo budget:
# `scripts/dojo.sh key lab`.
LITELLM_API_KEY=

# Utente Telegram autorizzato (il tuo user ID numerico, da @userinfobot).
TELEGRAM_ALLOWED_USERS=

# Porta della dashboard di Hermes su 127.0.0.1 (opzionale, default 9119). Le
# credenziali stanno in dashboard.env, che `scripts/dojo.sh sync` crea da solo.
# DASHBOARD_PORT=9119

# Porta dell'interfaccia web (hermes-webui) su 127.0.0.1 (opzionale, default
# 8787). Password in webui.env, che `scripts/dojo.sh sync` crea da solo.
# WEBUI_PORT=8787
