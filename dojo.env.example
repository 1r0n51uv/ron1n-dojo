# Configurazione del dojo: un solo file con tutto (ROOM-004). Copialo in
# dojo.env, accanto a questo, o lascia fare a scripts/install.sh. dojo.env
# non è versionato e `scripts/dojo.sh up` lo porta a permessi 600. Dopo ogni
# modifica: `scripts/dojo.sh up`, che applica il file alla room.
#
# Il modello di ogni agente non sta qui: si sceglie da Hermes (MODELS-007).

# Agenti accesi, separati da spazi. Un agente fuori da questa lista resta
# spento, anche se ha i suoi token.
DOJO_AGENTS=concierge strategist designer builder reviewer

# Il tuo user ID Telegram numerico (da @userinfobot): l'unico a cui gli agenti
# rispondono.
TELEGRAM_ALLOWED_USERS=

# Cartella del mini PC che contiene le cartelle delle rooms, con i tuoi
# permessi (ROOM-011). Ogni room ha la sua, con il suo nome: la lab lavora in
# ~/dojo/lab, le future home e work in ~/dojo/home e ~/dojo/work.
DOJO_ROOMS_DIR=~/dojo

# Porte su 127.0.0.1 di WebUI e dashboard di Hermes.
WEBUI_PORT=8787
DASHBOARD_PORT=9119

# Un bot Telegram per agente, da @BotFather: Hermes rifiuta lo stesso token
# su due agenti. I token GitHub sono fine-grained, del tuo account, limitati
# ai repo dei progetti; permessi per agente in docs/specs/rooms.md
# (ROOM-003).

# Nico Robin, concierge: nessun token GitHub, non tocca repo né tracker.
CONCIERGE_TELEGRAM_BOT_TOKEN=

# Shikamaru, strategist: contents, pull requests e issues in scrittura.
STRATEGIST_TELEGRAM_BOT_TOKEN=
STRATEGIST_GH_TOKEN=

# Bulma, designer: contents, pull requests e issues in scrittura.
DESIGNER_TELEGRAM_BOT_TOKEN=
DESIGNER_GH_TOKEN=

# Edward Elric, builder: contents, pull requests e issues in scrittura.
BUILDER_TELEGRAM_BOT_TOKEN=
BUILDER_GH_TOKEN=

# L, reviewer: contents in lettura, pull requests e issues in scrittura.
REVIEWER_TELEGRAM_BOT_TOKEN=
REVIEWER_GH_TOKEN=

# Jira Cloud (TRACKER-003), solo se un progetto in projects/ ha `tracker: jira`.
# Il tuo Jira personale: l'indirizzo, l'email dell'account e un token API
# (https://id.atlassian.com/manage-profile/security/api-tokens) per ogni
# agente che lavora sulle issue. Il token ha solo i progetti del dojo. Con
# almeno un progetto Jira `dojo.sh up` apre l'egress verso Atlassian.
# JIRA_URL=https://tuo-sito.atlassian.net
# JIRA_USERNAME=tu@example.com
# STRATEGIST_JIRA_API_TOKEN=
# DESIGNER_JIRA_API_TOKEN=
# BUILDER_JIRA_API_TOKEN=
# REVIEWER_JIRA_API_TOKEN=
